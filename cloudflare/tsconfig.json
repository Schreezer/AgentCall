{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "worker-configuration.d.ts"
  ]
}
