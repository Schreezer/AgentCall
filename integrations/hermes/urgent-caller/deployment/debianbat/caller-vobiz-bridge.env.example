# Copy to /home/chirag/.config/caller-vobiz-bridge.env, mode 0600.
# Fill all placeholders from the isolated outbound Worker and DebianBat runtime.
VOBIZ_RELAY_URL=https://REPLACE_WITH_ISOLATED_WORKER_URL
VOBIZ_RELAY_TOKEN=REPLACE_WITH_BRIDGE_ONLY_BEARER_TOKEN
VOBIZ_BRIDGE_SECRET=REPLACE_WITH_SHARED_STREAM_HMAC_SECRET
VOBIZ_CODEX_LAUNCHER=/home/chirag/.local/share/caller-vobiz-bridge/scripts/vobiz_codex_bwrap.sh
VOBIZ_BWRAP_BINARY=/usr/bin/bwrap
VOBIZ_CODEX_PACKAGE_ROOT=REPLACE_WITH_CANONICAL_CODEX_PACKAGE_DIRECTORY
VOBIZ_CODEX_ENTRY_REL=REPLACE_WITH_ENTRY_PATH_RELATIVE_TO_PACKAGE
VOBIZ_NODE_BINARY=REPLACE_WITH_CANONICAL_NODE_BINARY
CALLER_VOBIZ_L16_ENDIAN=big
# Keep false until the Worker inbound webhook, purchased DID binding, and
# DebianBat public WSS readiness have been verified together.
VOBIZ_BRIDGE_ALLOW_INBOUND=false
# Optional paired Caller iPhone notification after an inbound call ends.
# Set both or neither. These stay in the bridge and are not passed to Codex.
# CALLER_RELAY_URL=https://REPLACE_WITH_PAIRED_CALLER_RELAY
# CALLER_AGENT_TOKEN=REPLACE_WITH_CALLER_INSTALLATION_AGENT_TOKEN
